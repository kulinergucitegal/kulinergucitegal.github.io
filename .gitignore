# Bundler cache
.bundle
vendor
# Gemfile.lock sengaja DI-COMMIT, tidak di-ignore. Tanpa itu, Gemfile hanya
# menyebut rentang versi (~> 7.2) sehingga CI memasang Chirpy terbaru sementara
# mesin lokal tertinggal di versi lama - build lokal jadi tidak mencerminkan
# produksi, dan pembaruan tema bisa mengubah situs tanpa satu baris pun diubah.
# Pembaruan kini jadi keputusan sadar lewat `bundle update jekyll-theme-chirpy`.

# Jekyll cache
.jekyll-cache
.jekyll-metadata
_site
_site_*

# RubyGems
*.gem

# NPM dependencies
node_modules
package-lock.json

# IDE configurations
.idea
.vscode
!.vscode/settings.json
!.vscode/extensions.json

# Misc
.DS_Store
_sass/dist
assets/js/dist
